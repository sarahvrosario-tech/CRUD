<Window x:Class="CRUD.Feed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:modelos="clr-namespace:CRUD.Modelos"
        mc:Ignorable="d"
        Title="Feed" Height="450" Width="800">
    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">

                <!-- POST 1 -->
                <ItemsControl x:Name="ItemsControlFeed">
                    <ItemsControl.ItemTemplate>

                        <DataTemplate DataType="{x:Type modelos:Postagem}">

                            <Border Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16"
                                    Margin="0,0,0,12">

                                <StackPanel>

                                    <!-- Cabeçalho -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Usuario.Nome}"
                                                       FontWeight="Bold"
                                                       FontSize="15" />

                                            <TextBlock Text="{Binding Usuario.Username, StringFormat='@{0}'}"
                                                       Foreground="Gray"
                                                       FontSize="14" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Postado_em, StringFormat=' dd MMM - HH:mm'}"
                                                   Foreground="Gray"
                                                   FontSize="12" />
                                    </Grid>

                                    <!-- Conteúdo -->
                                    <TextBlock TextWrapping="Wrap"
                                               FontSize="14"
                                               Margin="0,0,0,12"
                                               Text="{Binding Conteudo}" />

                                    <!-- Rodapé -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Curtir"
                                                Padding="12,6"
                                                Margin="0,0,8,0" />

                                        <TextBlock Text="27 curtidas"
                                                   VerticalAlignment="Center"
                                                   Foreground="Gray" />
                                    </StackPanel>

                                </StackPanel>

                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


            </StackPanel>


        </ScrollViewer>


    </Grid>
</Window>