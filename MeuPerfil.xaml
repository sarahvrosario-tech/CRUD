<Window x:Class="CRUD.MeuPerfil"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meu Perfil"
        Height="600"
        Width="500"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F5F5">
        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="30" HorizontalAlignment="Center">

                <!-- Foto de Perfil -->
                <Ellipse Width="150"
                        Height="150"
                        Margin="0,10">
                    <Ellipse.Fill>
                        
                        <ImageBrush x:Name="imgPerfil"
                               ImageSource="https://cdn-icons-png.flaticon.com/512/3106/3106921.png"
                               Stretch="UniformToFill"/>
                        
                    </Ellipse.Fill>
                </Ellipse>

                <Button Content="Alterar Foto"
                        Width="120"
                        Height="35"
                        Margin="0,10,0,20"/>

                <!-- Nome -->
                <TextBlock Text="Nome"
                           FontWeight="Bold"/>
                <TextBox x:Name="txtNome"
                         Height="35"
                         Margin="0,5,0,15"/>

                <!-- Usuário -->
                <TextBlock Text="Usuário"
                           FontWeight="Bold"/>
                <TextBox x:Name="txtUsuario"
                         Height="35"
                         Margin="0,5,0,15"/>

                <!-- Email -->
                <TextBlock Text="Email"
                           FontWeight="Bold"/>
                <TextBox x:Name="txtEmail"
                         Height="35"
                         Margin="0,5,0,15"/>

                <!-- Senha -->
                <TextBlock Text="Senha"
                           FontWeight="Bold"/>
                <PasswordBox x:Name="txtSenha"
                             Height="35"
                             Margin="0,5,0,25"/>

                <!-- Botões -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button x:Name="btnSalvar"
                            Content="Salvar Alterações"
                            Width="160"
                            Height="40"
                            Background="#4CAF50"
                            Foreground="White"
                            FontWeight="Bold"
                            Margin="0,0,10,0"/>

                    <Button x:Name="btnDeletar"
                            Content="Deletar Perfil"
                            Width="140"
                            Height="40"
                            Background="#E53935"
                            Foreground="White"
                            FontWeight="Bold"/>
                </StackPanel>

            </StackPanel>

        </ScrollViewer>
    </Grid>
</Window>