<Window x:Class="CRUD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRUD"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <StackPanel Margin="20">
            <Label Content="Nome" FontWeight="Bold" Margin="0 0 0 2" />
            <TextBox FontSize="16" x:Name="txtNome" Height="25" VerticalAlignment="Center" />

            <Label Content="UserName" FontSize="16" FontWeight="Bold" Margin="0 0 0 2" />
            <TextBox FontSize="16" x:Name="txtUsername" Height="25" VerticalAlignment="Center" />

            <Label Content="Email" FontSize="16" FontWeight="Bold" Margin="0 0 0 2" />
            <TextBox FontSize="16" x:Name="txtEmail" Height="25" VerticalAlignment="Center" />

            <Label Content="Senha" FontSize="16" FontWeight="Bold" Margin="0 0 0 2" />
            <PasswordBox FontSize="16" x:Name="txtSenha" Height="25" VerticalAlignment="Center" />


            <Button Content="Cadastrar" FontSize="16" Click="btnCadastrar_OnClick"/>

        </StackPanel>


    </Grid>
</Window>